{
  "name": "@gramio/test",
  "version": "0.8.0",
  "description": "Event-driven test framework for GramIO Telegram bots",
  "keywords": [
    "gramio",
    "telegram",
    "test",
    "testing",
    "bot",
    "framework"
  ],
  "homepage": "https://gramio.dev/testing",
  "readme": "https://gramio.dev/testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramiojs/test.git"
  },
  "author": {
    "url": "https://github.com/kravetsone",
    "name": "kravets"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "type": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run type && bun test && bunx pkgroll"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@gramio/contexts": "^0.11.0",
    "@gramio/types": "^10.3.1",
    "@types/bun": "^1.3.9",
    "gramio": "^0.14.0",
    "pkgroll": "^2.25.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@gramio/contexts": ">=0.11.0 <1.0.0",
    "@gramio/types": ">=10.3.1 <11.0.0",
    "gramio": ">=0.14.0 <1.0.0"
  }
}
